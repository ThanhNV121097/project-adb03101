# Local Postgres username for docker compose.
POSTGRES_USER=app

# Local Postgres password for docker compose.
POSTGRES_PASSWORD=app_secret

# Local Postgres database name for docker compose.
POSTGRES_DB=app

# Backend listen port exposed on host.
BACKEND_PORT=8080

# Frontend listen port exposed on host.
FRONTEND_PORT=3000

# Browser-visible backend base URL for frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080
